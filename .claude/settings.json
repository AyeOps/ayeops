{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python -m ayeops.comments:*)",
      "Bash(uv run python -m ayeops.texthygiene:*)",
      "Bash(python -m ayeops.comments:*)",
      "Bash(python -m ayeops.texthygiene:*)",
      "Bash(uv run aye check:*)",
      "Bash(uv run aye render:*)",
      "Bash(aye check:*)",
      "Bash(aye render:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(aye deploy:*)",
      "Bash(uv run aye deploy:*)",
      "Bash(aye dns:*)",
      "Bash(uv run aye dns:*)",
      "Bash(aye secrets:*)",
      "Bash(uv run aye secrets:*)",
      "Bash(ssh:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose * up*)",
      "Bash(docker compose * down*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(git stash clear:*)",
      "Bash(git stash drop:*)",
      "Bash(git branch -D:*)",
      "Bash(git restore .:*)",
      "Bash(git checkout .:*)",
      "Bash(git checkout -- :*)",
      "Bash(git clean:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.prod)",
      "Read(**/.env.dev)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(printenv:*)",
      "Bash(env:*)"
    ]
  }
}
