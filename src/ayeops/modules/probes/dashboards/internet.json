  "schemaVersion": 39,
  "tags": [
    "ayeops"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(probe_success{job=\"blackbox-icmp\"}, group)",
        "includeAll": true,
        "label": {
          "en": "Group",
          "uk": "Група"
        },
        "multi": false,
