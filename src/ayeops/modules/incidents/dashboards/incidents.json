    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Minutes down of critical and page incidents times the weight of the service tier: critical 100, high 10, normal 1, low 0.1. Overlapping incidents of one service count once.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(ayeops_incident_downtime_minutes_total[$__range]) * on (service) group_left max by (service) (ayeops_service_criticality_weight)) or vector(0)",
          "instant": true,
          "legendFormat": "tier minutes",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Weighted downtime in range",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
