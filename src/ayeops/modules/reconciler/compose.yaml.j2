services:
  reconciler:
    image: python:3.13.16-alpine3.23@sha256:07b20c774a247152e74f622034c1482495d299e070eec620ddff13e01264290b
    command: ["python", "-I", "/app/reconciler.py"]
    network_mode: none
    read_only: true
    tmpfs: ["/tmp:size=4m"]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    pids_limit: 32
    environment:
      AYE_RECONCILER_INTERVAL: {{ settings.interval | tojson }}
      AYE_RECONCILER_ATTEMPTS: {{ settings.attempts | string | tojson }}
      AYE_RECONCILER_WINDOW: {{ settings.window | tojson }}
      AYE_RECONCILER_TIMEOUT: {{ settings.timeout | tojson }}
      AYE_RECONCILER_IGNORE: {{ settings.ignore | tojson | tojson }}
      AYE_RECONCILER_DRY_RUN: {{ (settings.dry_run | string | lower) | tojson }}
      AYE_RECONCILER_TEXTFILE: "/textfile/ayeops_reconciler.prom"
      AYE_RECONCILER_STATE: "/data/state.json"
    volumes:
      - "./reconciler/reconciler.py:/app/reconciler.py:ro"
      - "/var/run/docker.sock:/var/run/docker.sock"
      - "reconciler-data:/data"
      - {{ (textfile ~ ":/textfile") | tojson }}
    healthcheck:
      test: ["CMD", "python", "-c", "import os, sys, time; sys.exit(time.time() - os.path.getmtime('/tmp/reconciler.alive') > 300)"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 60s
volumes:
  reconciler-data: {}
{% if textfile == "node-textfile" %}
  node-textfile: {}
{% endif %}
