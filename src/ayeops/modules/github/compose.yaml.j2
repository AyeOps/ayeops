services:
  github-exporter:
    image: python:3.13.16-alpine3.23@sha256:07b20c774a247152e74f622034c1482495d299e070eec620ddff13e01264290b
    command: ["python", "-I", "/app/github_exporter.py"]
    user: "65534:65534"
    environment:
      AYE_GITHUB_TOKEN: "${AYE_GITHUB_TOKEN:?set AYE_GITHUB_TOKEN}"
      AYE_GITHUB_ACCOUNTS: {{ settings.accounts | tojson | tojson }}
      AYE_GITHUB_REPORTS: {{ settings.reports | join(",") | tojson }}
      AYE_GITHUB_REFRESH_SECONDS: {{ settings.refresh_seconds | string | tojson }}
      AYE_GITHUB_LOOKBACK_HOURS: {{ settings.lookback_hours | string | tojson }}
      AYE_GITHUB_IMPORT_URL: "http://victoriametrics:8428/api/v1/import/prometheus"
      AYE_GITHUB_STATE: "/tmp/imported.json"
      AYE_GITHUB_PORT: "9135"
    volumes:
      - "./github/github_exporter.py:/app/github_exporter.py:ro"
      - "github-state:/tmp"
    ports: [9135]
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9135/health', timeout=5)"]
      interval: 60s
      timeout: 10s
      retries: 3
volumes:
  github-state: {}
