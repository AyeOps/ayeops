services:
{% if settings.provider == "infisical" %}
  infisical:
    image: infisical/infisical:v0.166.3@sha256:c063089e4525b033fe6ab9e6858c3afb395ad38d363dcbfa6cbb6122a99a4eea
    environment:
      ENCRYPTION_KEY: "${AYE_SECRETS_ENCRYPTION_KEY:?set AYE_SECRETS_ENCRYPTION_KEY}"
      AUTH_SECRET: "${AYE_SECRETS_AUTH_SECRET:?set AYE_SECRETS_AUTH_SECRET}"
      DB_CONNECTION_URI: "postgres://infisical:${AYE_SECRETS_DB_PASSWORD:?set AYE_SECRETS_DB_PASSWORD}@infisical-db:5432/infisical"
      REDIS_URL: "redis://:${AYE_SECRETS_CACHE_PASSWORD:?set AYE_SECRETS_CACHE_PASSWORD}@infisical-cache:6379"
      SITE_URL: {{ settings.url | tojson }}
      TELEMETRY_ENABLED: "false"
      OTEL_TELEMETRY_COLLECTION_ENABLED: "true"
      OTEL_EXPORT_TYPE: prometheus
      OTEL_DROP_HIGH_CARDINALITY_METERS: "true"
      NODE_OPTIONS: "--max-old-space-size={{ settings.resources.get('infisical', {}).get('memory', '1g') | heap_mb }}"
{% if settings.google_login %}
      CLIENT_ID_GOOGLE_LOGIN: "${AYE_SECRETS_GOOGLE_CLIENT_ID:?set AYE_SECRETS_GOOGLE_CLIENT_ID}"
      CLIENT_SECRET_GOOGLE_LOGIN: "${AYE_SECRETS_GOOGLE_CLIENT_SECRET:?set AYE_SECRETS_GOOGLE_CLIENT_SECRET}"
{% endif %}
{% if mail %}
      SMTP_HOST: {{ mail.host | tojson }}
      SMTP_PORT: {{ mail.port | string | tojson }}
      SMTP_USERNAME: {{ mail.user | tojson }}
      SMTP_PASSWORD: {{ mail.password | tojson }}
      SMTP_FROM_ADDRESS: {{ mail.from | tojson }}
      SMTP_FROM_NAME: {{ mail.from_name | tojson }}
{% if mail.tls != "tls" %}
      SMTP_REQUIRE_TLS: {{ (mail.tls == "starttls") | string | lower | tojson }}
      SMTP_IGNORE_TLS: {{ (mail.tls == "none") | string | lower | tojson }}
{% endif %}
{% endif %}
    ports: ["8090:8080"]
    depends_on:
      infisical-db:
        condition: service_healthy
      infisical-cache:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/api/status"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 180s
  infisical-db:
    image: postgres:18.6-alpine3.24@sha256:9ba53c7d41ea093baf5c1ba635ba5434c4f979880527d49bb7d9237d3193085b
    command: ["postgres", "-c", "shared_buffers=64MB", "-c", "max_connections=50"]
    environment:
      POSTGRES_USER: infisical
      POSTGRES_DB: infisical
      POSTGRES_PASSWORD: "${AYE_SECRETS_DB_PASSWORD:?set AYE_SECRETS_DB_PASSWORD}"
    volumes:
      - "secrets-db:/var/lib/postgresql"
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "infisical", "-d", "infisical"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 30s
  infisical-cache:
    image: valkey/valkey:9.1.3-alpine3.24@sha256:bf09d58e96d6b4524a15396b65b242bbe18beebbcc15a04d8ee75ddac62fae0b
    command: ["sh", "-c", "exec valkey-server --requirepass \"$$VALKEYCLI_AUTH\" --maxmemory 48mb --maxmemory-policy noeviction --save '' --appendonly no"]
    environment:
      VALKEYCLI_AUTH: "${AYE_SECRETS_CACHE_PASSWORD:?set AYE_SECRETS_CACHE_PASSWORD}"
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 6
  infisical-backup:
    image: postgres:18.6-alpine3.24@sha256:9ba53c7d41ea093baf5c1ba635ba5434c4f979880527d49bb7d9237d3193085b
    command: ["sh", "/backup.sh"]
    read_only: true
    tmpfs: ["/tmp:size=16m"]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    environment:
      PGHOST: infisical-db
      PGUSER: infisical
      PGDATABASE: infisical
      PGPASSWORD: "${AYE_SECRETS_DB_PASSWORD:?set AYE_SECRETS_DB_PASSWORD}"
      AYE_BACKUP_DIR: /backups
      AYE_TEXTFILE_DIR: /textfile
      AYE_BACKUP_HOUR: {{ settings.backup_hour | string | tojson }}
      AYE_BACKUP_KEEP_DAYS: {{ settings.backup_keep_days | string | tojson }}
    volumes:
      - "./secrets/backup.sh:/backup.sh:ro"
      - "./backups/backup_run.sh:/backup_run.sh:ro"
      - "secrets-backups:/backups"
      - {{ (textfile ~ ":/textfile") | tojson }}
    depends_on:
      infisical-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "find /tmp/backup.alive -mmin -15 | grep -q ."]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 120s
{% endif %}
volumes:
  secrets-db: {}
  secrets-backups: {}
{% if textfile == "node-textfile" %}
  node-textfile: {}
{% endif %}
