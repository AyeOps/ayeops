        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|devtmpfs|nsfs\",host=~\"$host\"}",
          "legendFormat": {
            "en": "{{mountpoint}} now",
            "uk": "{{mountpoint}} зараз"
          },
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "clamp_min(predict_linear(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|devtmpfs|nsfs\",host=~\"$host\"}[1d], 7 * 86400), 0)",
          "legendFormat": {
            "en": "{{mountpoint}} in 7 days",
            "uk": "{{mountpoint}} через 7 днів"
          },
          "refId": "B"
        }
      ],
