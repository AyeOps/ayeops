services:
  traefik:
    image: traefik:v3.7.14@sha256:575fa15b135078fe5e50aa847987d96dbddd7b093c172429618404df73f3fa7c
    command:
      - "--configFile=/etc/traefik/traefik.yml"
    environment:
      CF_DNS_API_TOKEN: "${AYE_CLOUDFLARE_DNS_API_TOKEN:?set AYE_CLOUDFLARE_DNS_API_TOKEN}"
    volumes:
      - "./ingress/traefik.yml:/etc/traefik/traefik.yml:ro"
      - "./ingress/dynamic:/etc/traefik/dynamic:ro"
      - "ingress-acme:/acme"
    ports: [443, 80]
    networks:
      default:
        aliases:
{% for name, target in settings.routes | dictsort %}
          - {{ (name ~ "." ~ settings.domain) | tojson }}
{% endfor %}
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--configFile=/etc/traefik/traefik.yml"]
      interval: 30s
      timeout: 5s
      retries: 3
volumes:
  ingress-acme: {}
