global:
  checkNewVersion: false
  sendAnonymousUsage: false
log:
  level: INFO
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
  metrics:
    address: ":8082"
ping:
  entryPoint: metrics
metrics:
  prometheus:
    entryPoint: metrics
providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true
certificatesResolvers:
  letsencrypt:
    acme:
{% if settings.email %}
      email: {{ settings.email | tojson }}
{% endif %}
      storage: /acme/acme.json
      dnsChallenge:
        provider: {{ settings.provider | tojson }}
        resolvers: ["1.1.1.1:53", "1.0.0.1:53"]
