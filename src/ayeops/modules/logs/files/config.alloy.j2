logging {
  level = "warn"
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"

  filter {
    name   = "status"
    values = ["running"]
  }
}

discovery.relabel "projects" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = {{ logs.projects_regex | tojson }}
    action        = "keep"
  }
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.projects.output
  relabel_rules    = discovery.relabel.containers.rules
  refresh_interval = "10s"
  labels           = {job = "docker"}
  forward_to       = [loki.write.central.receiver]
}
{% if settings.journald %}

discovery.relabel "journal" {
  targets = []

  rule {
    source_labels = ["__journal_container_id"]
    regex         = ".+"
    action        = "drop"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "system" {
  max_age       = "12h"
  relabel_rules = discovery.relabel.journal.rules
  labels        = {job = "journald"}
  forward_to    = [loki.write.central.receiver]
}
{% endif %}

loki.write "central" {
  endpoint {
    url = {{ logs.push_url | tojson }}
  }

  external_labels = {host = {{ host.name | tojson }}, project = {{ project | tojson }}{% if host.group %}, group = {{ host.group | tojson }}{% endif %}}
}
