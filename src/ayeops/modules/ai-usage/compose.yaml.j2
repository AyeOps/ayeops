services:
  ai-usage-exporter:
    image: python:3.13.16-alpine3.23@sha256:07b20c774a247152e74f622034c1482495d299e070eec620ddff13e01264290b
    command: ["python", "-I", "/app/ai_usage_exporter.py"]
    user: "65534:65534"
    environment:
{% if "anthropic" in settings.providers %}
      AYE_ANTHROPIC_ADMIN_KEY: "${AYE_ANTHROPIC_ADMIN_KEY:?set AYE_ANTHROPIC_ADMIN_KEY}"
{% endif %}
{% if "openai" in settings.providers %}
      AYE_OPENAI_ADMIN_KEY: "${AYE_OPENAI_ADMIN_KEY:?set AYE_OPENAI_ADMIN_KEY}"
{% endif %}
      AYE_AI_PROVIDERS: {{ settings.providers | join(",") | tojson }}
      AYE_AI_BUDGETS: {{ settings.monthly_budget_usd | tojson | tojson }}
      AYE_AI_SPIKE_FLOOR_USD: {{ settings.spike_floor_usd | string | tojson }}
      AYE_AI_REFRESH_SECONDS: {{ settings.refresh_seconds | string | tojson }}
      AYE_AI_PORT: "9147"
    volumes:
      - "./ai-usage/ai_usage_exporter.py:/app/ai_usage_exporter.py:ro"
    ports: [9147]
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9147/health', timeout=5)"]
      interval: 60s
      timeout: 10s
      retries: 3
volumes: {}
