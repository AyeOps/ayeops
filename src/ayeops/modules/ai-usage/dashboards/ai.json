{
  "editable": false,
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": [
    "ayeops"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(ayeops_ai_provider_enabled, provider)",
        "includeAll": true,
        "label": {
          "en": "Provider",
          "uk": "Постачальник"
        },
        "multi": true,
        "name": "provider",
        "query": {
          "query": "label_values(ayeops_ai_provider_enabled, provider)",
          "refId": "provider"
        },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "title": {
    "en": "AyeOps / AI",
    "uk": "AyeOps / ШІ"
  },
  "uid": "ayeops-ai",
  "version": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": {
        "en": "This month",
        "uk": "Цей місяць"
      },
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (provider) (ayeops_ai_cost_month_usd{provider=~\"$provider\"})",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Spent this month",
        "uk": "Витрачено за місяць"
      },
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "min": 0,
          "max": 120
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum by (provider) (ayeops_ai_cost_month_usd{provider=~\"$provider\"}) / on (provider) ayeops_ai_budget_usd{provider=~\"$provider\"}",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Budget used, %",
        "uk": "Використано бюджету, %"
      },
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (provider) (ayeops_ai_cost_day_usd{provider=~\"$provider\"})",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Spent today",
        "uk": "Витрачено сьогодні"
      },
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "ayeops_ai_cost_daily_median_7d_usd{provider=~\"$provider\"}",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Median day of the last week",
        "uk": "Медіанний день минулого тижня"
      },
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "panels": [],
      "title": {
        "en": "Models",
        "uk": "Моделі"
      },
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 7,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sort_desc(sum by (provider, model) (ayeops_ai_cost_month_usd{provider=~\"$provider\"}))",
          "legendFormat": "{{provider}} · {{model}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": {
        "en": "Spent this month by model",
        "uk": "Витрачено за місяць за моделями"
      },
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 8,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "1e6 * sum by (provider, model) (ayeops_ai_cost_month_usd{provider=~\"$provider\"}) / sum by (provider, model) (ayeops_ai_tokens_month{provider=~\"$provider\"})",
          "legendFormat": "{{provider}} · {{model}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": {
        "en": "Actual cost per 1M tokens",
        "uk": "Вартість за 1M токенів, фактична"
      },
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 9,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (provider, model) (ayeops_ai_cost_day_usd{provider=~\"$provider\"})",
          "legendFormat": "{{provider}} · {{model}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Spend of the day so far by model",
        "uk": "Витрати дня наростаючим підсумком за моделями"
      },
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 10,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (provider, kind) (ayeops_ai_tokens_day{provider=~\"$provider\"})",
          "legendFormat": "{{provider}} · {{kind}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Tokens of the day so far by kind",
        "uk": "Токени дня наростаючим підсумком за видом"
      },
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "id": 11,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (provider, model) (ayeops_ai_tokens_month{provider=~\"$provider\",kind=\"input_cache_read\"}) / sum by (provider, model) (ayeops_ai_tokens_month{provider=~\"$provider\",kind=~\"input_.*\"})",
          "legendFormat": "{{provider}} · {{model}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": {
        "en": "Cache reads among input tokens, this month",
        "uk": "Частка читань з кешу серед вхідних токенів, місяць"
      },
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "id": 12,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sort_desc(sum by (provider, model) (ayeops_ai_requests_month{provider=~\"$provider\"}))",
          "legendFormat": "{{provider}} · {{model}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": {
        "en": "Requests this month by model",
        "uk": "Запити за місяць за моделями"
      },
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 13,
      "panels": [],
      "title": {
        "en": "Limits and reports",
        "uk": "Ліміти і звіти"
      },
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "id": 14,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "ayeops_ai_rate_limit{provider=~\"$provider\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "title": {
        "en": "Rate limits",
        "uk": "Ліміти частоти"
      },
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 31
      },
      "id": 15,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "(ayeops_ai_api_key_expiry_timestamp_seconds{provider=~\"$provider\"} - time()) / 86400",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "title": {
        "en": "API keys: days until expiry",
        "uk": "API-ключі: днів до кінця строку"
      },
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": {
                    "en": "Failing",
                    "uk": "Не відповідає"
                  }
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": {
                    "en": "OK",
                    "uk": "Працює"
                  }
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 31
      },
      "id": 16,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "min by (provider, dataset) (ayeops_ai_query_success{provider=~\"$provider\"})",
          "legendFormat": "{{provider}} · {{dataset}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Reports answering",
        "uk": "Звіти відповідають"
      },
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 35
      },
      "id": 17,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - ayeops_ai_last_success_timestamp_seconds{provider=~\"$provider\"}",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Since the last full answer",
        "uk": "Від останньої повної відповіді"
      },
      "type": "stat"
    }
  ]
}
