        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count(up{host=~\"$host\",job=~\"$job\"} == 0) or vector(0)",
