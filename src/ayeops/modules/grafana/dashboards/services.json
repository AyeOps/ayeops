          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(up, group)",
        "includeAll": true,
        "label": {
          "en": "Group",
          "uk": "Група"
        },
        "multi": false,
        "name": "group",
        "query": {
          "query": "label_values(up, group)",
          "refId": "group"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(up{group=~\"$group\"}, host)",
        "includeAll": true,
        "label": {
          "en": "Host",
          "uk": "Хост"
        },
        "multi": true,
        "name": "host",
        "query": {
          "query": "label_values(up{group=~\"$group\"}, host)",
          "refId": "host"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(up{host=~\"$host\"}, job)",
        "includeAll": true,
        "label": {
          "en": "Job",
          "uk": "Завдання"
        },
        "multi": true,
        "name": "job",
        "query": {
          "query": "label_values(up{host=~\"$host\"}, job)",
          "refId": "job"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
