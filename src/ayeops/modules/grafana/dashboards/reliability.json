      "title": {
        "en": "Availability of the probed URLs, 30 days",
        "uk": "Доступність URL під пробами, 30 днів"
      },
      "type": "row"
    },
    {
      "ayeopsRequires": [
        "probes.http"
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": {
        "en": "Share of probes that got a 2xx answer over the last 30 days.",
        "uk": "Частка проб із відповіддю 2xx за останні 30 днів."
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 99,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * avg_over_time(probe_success{job=\"blackbox-http\"}[30d])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Availability, %",
        "uk": "Доступність, %"
      },
      "type": "bargauge"
    },
    {
      "ayeopsRequires": [
