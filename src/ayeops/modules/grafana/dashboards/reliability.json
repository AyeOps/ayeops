    },
    {
      "ayeopsRequires": [
        "backups"
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": {
        "en": "Jobs whose dump a service declares under data with an rpo: the age of the last good dump next to that rpo. A share of 100 % or more means the newest restore point is older than the service accepts.",
        "uk": "Дампи, для яких сервіс оголошує rpo у data: вік останнього вдалого дампу поруч із цим rpo. Частка від 100 % означає, що найновіша точка відновлення старша, ніж сервіс допускає."
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "id": 17,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "(time() - max by (host, backup) (ayeops_backup_last_success_timestamp_seconds)) and on (host, backup) max by (host, backup) (ayeops_backup_rpo_seconds)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (host, backup) (ayeops_backup_rpo_seconds)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * (time() - max by (host, backup) (ayeops_backup_last_success_timestamp_seconds)) / max by (host, backup) (ayeops_backup_rpo_seconds)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        }
      ],
      "title": {
        "en": "Last good dump against its RPO",
        "uk": "Останній вдалий дамп проти його RPO"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "backup": 1,
              "host": 0
            },
            "renameByName": {
              "Value #A": {
                "en": "Age of the last good dump",
                "uk": "Вік останнього вдалого дампу"
              },
              "Value #B": {
                "en": "RPO",
                "uk": "RPO"
              },
              "Value #C": {
                "en": "Share of the RPO",
                "uk": "Частка RPO"
              },
              "backup": {
                "en": "Job",
                "uk": "Дамп"
              },
              "host": {
                "en": "Host",
                "uk": "Хост"
              }
            }
          }
        }
      ],
      "type": "table"
    }
