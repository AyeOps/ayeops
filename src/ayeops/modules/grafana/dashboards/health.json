      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (host) (node_load5) / count by (host) (node_cpu_seconds_total{mode=\"idle\"})",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Load per core, 5 min",
        "uk": "Навантаження на ядро, 5 хв"
