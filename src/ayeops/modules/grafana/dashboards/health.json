        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": {
                    "en": "Down",
                    "uk": "Лежить"
                  }
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": {
                    "en": "Up",
                    "uk": "Працює"
                  }
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "up{job=\"node\"}",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": {
        "en": "Up",
        "uk": "Стан"
      },
      "type": "stat"
