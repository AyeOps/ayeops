services:
  grafana:
    image: grafana/grafana:13.2.3@sha256:b28bae15e219c998fb0e0424ed724930cc61b1f61fb404d47c862f9a23f9e572
    environment:
      GF_SECURITY_ADMIN_USER: "${AYE_GRAFANA_ADMIN_USER:?set AYE_GRAFANA_ADMIN_USER}"
      GF_SECURITY_ADMIN_PASSWORD: "${AYE_GRAFANA_ADMIN_PASSWORD:?set AYE_GRAFANA_ADMIN_PASSWORD}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
{% set auth = modules.get("auth") %}
{% set ingress = modules.get("ingress") or {} %}
{% set ns = namespace(root_url=settings.root_url) %}
{% for name, target in (ingress.get("routes") or {}) | dictsort %}
{% if auth and not ns.root_url and target.split(":")[0] == "grafana" %}
{% set ns.root_url = "https://" ~ name ~ "." ~ ingress.domain %}
{% endif %}
{% endfor %}
{% set root_url = ns.root_url %}
{% if root_url %}
      GF_SERVER_ROOT_URL: {{ root_url | tojson }}
{% endif %}
{% if auth %}
{% set prefix = "GF_AUTH_GOOGLE_" if auth.provider == "google" else "GF_AUTH_GENERIC_OAUTH_" %}
{% set admins = auth.admins if auth.admins is not none else auth.emails %}
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      {{ prefix }}ENABLED: "true"
      {{ prefix }}CLIENT_ID: "${AYE_AUTH_CLIENT_ID:?set AYE_AUTH_CLIENT_ID}"
      {{ prefix }}CLIENT_SECRET: "${AYE_AUTH_CLIENT_SECRET:?set AYE_AUTH_CLIENT_SECRET}"
      {{ prefix }}SCOPES: openid email profile
      {{ prefix }}USE_PKCE: "true"
      {{ prefix }}ALLOW_SIGN_UP: "true"
      {{ prefix }}ROLE_ATTRIBUTE_PATH: {{ ("contains(" ~ (admins | tojson | replace('"', "'")) ~ ", email) && 'GrafanaAdmin' || contains(" ~ (auth.emails | tojson | replace('"', "'")) ~ ", email) && 'Viewer' || ''") | tojson }}
      {{ prefix }}ROLE_ATTRIBUTE_STRICT: "true"
      {{ prefix }}ALLOW_ASSIGN_GRAFANA_ADMIN: "true"
      {{ prefix }}SKIP_ORG_ROLE_SYNC: "false"
{% if auth.provider == "oidc" %}
      GF_AUTH_GENERIC_OAUTH_NAME: OIDC
{% if auth.endpoints %}
      GF_AUTH_GENERIC_OAUTH_AUTH_URL: {{ auth.endpoints.authorize | tojson }}
      GF_AUTH_GENERIC_OAUTH_TOKEN_URL: {{ auth.endpoints.token | tojson }}
      GF_AUTH_GENERIC_OAUTH_API_URL: {{ auth.endpoints.userinfo | tojson }}
{% endif %}
{% endif %}
{% endif %}
{% if mail %}
      GF_SMTP_ENABLED: "true"
      GF_SMTP_HOST: {{ mail.address | tojson }}
      GF_SMTP_USER: {{ mail.user | tojson }}
      GF_SMTP_PASSWORD: {{ mail.password | tojson }}
      GF_SMTP_FROM_ADDRESS: {{ mail.from | tojson }}
      GF_SMTP_FROM_NAME: {{ mail.from_name | tojson }}
      GF_SMTP_STARTTLS_POLICY: {{ "MandatoryStartTLS" if mail.tls == "starttls" else "NoStartTLS" }}
{% endif %}
{% if contact == "telegram" %}
      AYE_TELEGRAM_BOT_TOKEN: "${AYE_TELEGRAM_BOT_TOKEN:?set AYE_TELEGRAM_BOT_TOKEN}"
      AYE_TELEGRAM_CHAT_ID: "${AYE_TELEGRAM_CHAT_ID:?set AYE_TELEGRAM_CHAT_ID}"
{% endif %}
{% if "oncall" in modules %}
      AYE_ONCALL_WEBHOOK_SECRET: "${AYE_ONCALL_WEBHOOK_SECRET:?set AYE_ONCALL_WEBHOOK_SECRET}"
{% endif %}
{% if "autopilot" in modules %}
      AYE_AUTOPILOT_WEBHOOK_SECRET: "${AYE_AUTOPILOT_WEBHOOK_SECRET:?set AYE_AUTOPILOT_WEBHOOK_SECRET}"
{% endif %}
{% for source in settings.datasources if source.get("password_env") %}
      {{ source.password_env }}: "${ {{- source.password_env }}:?set {{ source.password_env }}}"
{% endfor %}
    volumes:
      - "grafana-data:/var/lib/grafana"
      - "./grafana/provisioning:/etc/grafana/provisioning:ro"
      - "./grafana/dashboards:/etc/grafana/dashboards:ro"
{% if settings.dashboards %}
      - "./grafana/project-dashboards:/etc/grafana/project-dashboards:ro"
{% endif %}
    ports: [3000]
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:3000/api/health"]
      interval: 30s
      timeout: 5s
      retries: 3
{% if grafana_reader.enabled %}
  grafana-reader:
    image: python:3.13.16-alpine3.23@sha256:07b20c774a247152e74f622034c1482495d299e070eec620ddff13e01264290b
    command: ["python", "-I", "/app/grafana_reader.py"]
    user: {{ (grafana_reader.group ~ ":" ~ grafana_reader.group) | tojson }}
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    environment:
      AYE_GRAFANA_URL: http://grafana:3000
      AYE_GRAFANA_ADMIN_USER: "${AYE_GRAFANA_ADMIN_USER:?set AYE_GRAFANA_ADMIN_USER}"
      AYE_GRAFANA_ADMIN_PASSWORD: "${AYE_GRAFANA_ADMIN_PASSWORD:?set AYE_GRAFANA_ADMIN_PASSWORD}"
      AYE_GRAFANA_READER_TOKEN_FILE: /tmp/token
      AYE_GRAFANA_READER_PORT: "9137"
    volumes:
      - "./grafana/grafana_reader.py:/app/grafana_reader.py:ro"
      - {{ (grafana_reader.volume_name ~ ":/tmp") | tojson }}
    depends_on:
      grafana:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9137/health', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
{% endif %}
volumes:
  grafana-data: {}
{% if grafana_reader.enabled %}
  grafana-reader: {}
{% endif %}
