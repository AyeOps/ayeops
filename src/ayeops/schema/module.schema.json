{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ayeops.dev/schema/module.schema.json",
  "title": "AyeOps module",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "summary", "settings_schema", "services"],
  "properties": {
    "name": {"$ref": "#/$defs/name"},
    "summary": {"type": "string", "minLength": 1},
    "runbook_base_url": {"type": "string", "pattern": "^https?://"},
    "requires": {
      "type": ["object", "null"],
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"type": ["object", "null"]}
    },
    "defaults": {"type": ["object", "null"]},
    "settings_schema": {"type": "object"},
    "services": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/service"}
    },
    "alerts": {"type": ["array", "null"], "items": {"$ref": "#/$defs/alert"}},
    "logging": {"$ref": "#/$defs/logging"},
    "dashboards": {
      "type": ["array", "null"],
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.json$"}
    },
    "files": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "dest"],
        "properties": {
          "src": {"$ref": "#/$defs/relative"},
          "dest": {"$ref": "#/$defs/relative"},
          "when": {"type": "string", "minLength": 1},
          "template": {"type": "boolean"},
          "live": {"type": "boolean"}
        }
      }
    },
    "permissions": {"type": ["array", "null"], "items": {"$ref": "#/$defs/permission"}},
    "generated": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["env", "format"],
        "properties": {
          "env": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/env"}},
          "when": {"type": "string", "minLength": 1},
          "format": {"enum": ["hex", "base64", "base64url", "garage-key-id", "copy"]},
          "bytes": {"type": "integer", "minimum": 8, "maximum": 64},
          "from": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"format": {"enum": ["hex", "base64", "base64url"]}}},
            "then": {"required": ["bytes"], "not": {"required": ["from"]}}
          },
          {
            "if": {"properties": {"format": {"const": "garage-key-id"}}},
            "then": {"not": {"anyOf": [{"required": ["bytes"]}, {"required": ["from"]}]}}
          },
          {
            "if": {"properties": {"format": {"const": "copy"}}},
            "then": {"required": ["from"], "not": {"required": ["bytes"]}}
          }
        ]
      }
    },
    "host_directories": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["setting", "owner", "mode", "for"],
        "properties": {
          "setting": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
          "owner": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
          "mode": {"type": "string", "pattern": "^0[0-7]{3}$"},
          "for": {"type": "string", "minLength": 1},
          "when": {"type": "string", "minLength": 1}
        }
      }
    },
    "backup_jobs": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "service", "schedule", "timezone"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
          "service": {"$ref": "#/$defs/name"},
          "schedule": {"type": "string", "minLength": 1},
          "timezone": {"type": "string", "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$"},
          "grace": {"type": "string", "pattern": "^[1-9][0-9]{0,3}[mh]$"}
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"},
    "env": {"type": "string", "pattern": "^([A-Z][A-Z0-9_]*|\\{\\{.+\\}\\})$"},
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "credential", "env", "grants"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "credential": {"type": "string", "minLength": 1},
        "env": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/env"}},
        "when": {"type": "string", "minLength": 1},
        "each": {"type": "string", "minLength": 1},
        "grants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver"],
      "properties": {
        "driver": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "options": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "relative": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_./-]+$"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory", "cpus"],
      "properties": {
        "description": {"type": "string"},
        "memory": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?[kmg]$"},
        "cpus": {"type": "number", "exclusiveMinimum": 0},
        "metrics": {
          "oneOf": [
            {"type": "array", "items": {"type": "string", "minLength": 1}},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["none"],
              "properties": {"none": {"type": "string"}}
            }
          ]
        },
        "alerts": {"type": "array", "items": {"$ref": "#/$defs/name"}},
        "logs": {"type": "string", "pattern": "^(docker|journald|syslog|file:.+)$"},
        "status": {"type": "object"},
        "login": {"type": "string"},
        "grafana_reader": {"type": "boolean"},
        "url": {"type": "string", "pattern": "^https?://"},
        "icon": {"type": "string", "pattern": "^[a-z0-9.-]{1,40}$"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric"],
      "properties": {
        "metric": {"type": "string", "pattern": "^[A-Za-z_:][A-Za-z0-9_:]*(\\{[^{}]*\\})?$"},
        "kind": {"enum": ["counter", "gauge"]},
        "by": {"type": "array", "items": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"}, "uniqueItems": true},
        "window": {"type": "string", "pattern": "^[0-9]+[mh]$"},
        "below": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "floor": {"type": "number", "minimum": 0},
        "above": {"type": "number", "exclusiveMinimum": 1},
        "empty_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "quiet": {"type": "array", "items": {"$ref": "#/$defs/baseline_quiet"}},
        "skip": {"type": "array", "items": {"$ref": "#/$defs/baseline_skip"}}
      }
    },
    "baseline_quiet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "days": {"type": "array", "items": {"enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]}, "uniqueItems": true},
        "from": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "to": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}
      }
    },
    "baseline_skip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "reason"],
      "properties": {
        "match": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "oneOf": [{"required": ["expr"]}, {"required": ["baseline"]}],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "title": {"type": "string"},
        "expr": {"type": "string", "minLength": 1},
        "baseline": {"$ref": "#/$defs/baseline"},
        "for": {"type": "string", "pattern": "^[0-9]+[smhd]$"},
        "severity": {"enum": ["page", "critical", "warning", "info"]},
        "summary": {"type": "string"},
        "runbook": {"type": "string"},
        "dashboard": {
          "oneOf": [
            {"const": false},
            {"type": "string", "minLength": 1},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["uid"],
              "properties": {"uid": {"type": "string", "minLength": 1}, "panel": {"type": "integer", "minimum": 1}}
            }
          ]
        },
        "provider": {"type": "string", "minLength": 1},
        "setting": {"type": "string", "minLength": 1},
        "only_with": {"enum": ["grafana_reader"]},
        "no_data": {"enum": ["alerting", "ok"]}
      }
    }
  }
}
