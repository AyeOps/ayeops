  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(aye_report_info, project)",
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project",
        "query": {
          "query": "label_values(aye_report_info, project)",
          "refId": "project"
        },
        "refresh": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(aye_report_info{project=~\"$project\"}, branch)",
        "includeAll": true,
        "label": "Branch",
        "multi": true,
        "name": "branch",
        "query": {
          "query": "label_values(aye_report_info{project=~\"$project\"}, branch)",
          "refId": "branch"
        },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
